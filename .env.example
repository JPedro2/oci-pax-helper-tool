# Copy to .env and adjust. Loaded automatically by push-to-ecr.sh.
# Precedence: CLI flag > shell environment variable > this file > built-in default.
# (.env is gitignored; never commit real values.)

# --- ECR push ---
# ECR registry namespace
REGISTRY_NAME=custeng-sa-oci
# AWS region of the ECR registry
AWS_DEFAULT_REGION=eu-west-2
# Repo base path under the registry namespace
PACK_BASE_PATH=spectro-packs/archive

# --- Palette sync (only needed when using --sync / --sync-only) ---
# API key — SECRET. Set it here (or export it); never pass it as a CLI flag.
PALETTE_API_KEY=
# Palette API host (SaaS default shown; use your FQDN for self-hosted/Vertex)
PALETTE_HOST=api.spectrocloud.com
# The registry's display name in Palette (resolved to its UID via the API).
# Quote any value that contains spaces — this file is sourced as shell.
PALETTE_REGISTRY_NAME="SA OCI Registry"
# Registry type: ecr | basic
PALETTE_REGISTRY_TYPE=ecr
# Project UID — only for project-scoped registries; leave empty for tenant scope
PALETTE_PROJECT_UID=
